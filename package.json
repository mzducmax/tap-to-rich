{
  "name": "stack-box",
  "private": true,
  "version": "1.0.0",
  "description": "Stack Box — 2.5D isometric stacking game with TikTok live integration",
  "author": "Zonee",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=4173 --host=0.0.0.0",
    "build": "vite build",
    "build:obfuscated": "vite build && node scripts/obfuscate-dist.cjs",
    "preview": "vite preview --port=4173 --host=0.0.0.0",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "icons": "node scripts/generate-icons.cjs",
    "electron:dev": "npm run icons && concurrently -k \"vite --port=4173 --host=localhost\" \"wait-on http://localhost:4173 && cross-env VITE_DEV_SERVER_URL=http://localhost:4173 electron electron/main.cjs\"",
    "electron:build": "npm run icons && npm run build:obfuscated && electron-builder --win",
    "electron:pack": "npm run icons && npm run build:obfuscated && electron-builder --win --dir"
  },
  "build": {
    "appId": "pro.zonee.stack-box",
    "productName": "Stack Box",
    "copyright": "Copyright © Zonee",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stack Box",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^5.4.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.5"
  }
}
