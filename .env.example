# Gemini (tùy chọn)
GEMINI_API_KEY=""

APP_URL="http://localhost:4173"

# true = dev (localhost:6896)  |  false = live (play.zonee.pro)
VITE_USE_DEV_API="true"

# Ghi đè URL (để trống thì tự chọn theo VITE_USE_DEV_API)
# Dev:  http://localhost:6896/api
# Live: https://play.zonee.pro/api
VITE_API_BASE_URL="http://localhost:6896/api"
VITE_LOGIN_PATH="login-game-client"
VITE_WS_FETCH_PATH="fetch-ws"
VITE_GAME_ID="stack_box"
VITE_GAME_SETTINGS_ID="stack_box"
VITE_RANK_GAME_ID="stack_box"

VITE_AUTH_SECRET="stack-box-local-dev-secret"

# Electron desktop — email streamer (tùy chọn, thay cho ?email= trên URL)
# STREAMER_EMAIL="you@example.com"
